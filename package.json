{
  "name": "connectmq-mqtt-publish",
  "version": "1.0.0",
  "description": "GitHub Action: publish an MQTT message to ConnectMQ or any MQTT 3.1.1 / 5.0 broker, optionally waiting for a reply.",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "ncc build src/index.js -o dist --license licenses.txt",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "github-action",
    "mqtt",
    "iot",
    "connectmq",
    "ota",
    "notification"
  ],
  "author": "ConnectMQ",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3"
  }
}
